---
import Base from '@/layouts/Base.astro';
import WaLink from '@/components/WaLink.astro';
import Proof from '@/components/Proof.astro';
import MobileBar from '@/components/MobileBar.astro';
import contact from '@/data/contact.json';
import casos from '@/data/casos.json';
import { ORG, SITE, graph } from '@/lib/schema';
const v = contact.productos.ventas.nombre;
const demo = contact.calcom.url; const dur = contact.calcom.duracion.replace(' minutos', ' min');
const ld = graph(ORG, {
  '@type': 'Service',
  '@id': `${SITE}/inmobiliarias#servicio`,
  name: v,
  serviceType: 'Agentes de IA para inmobiliarias',
  description: `${v}: agentes de inteligencia artificial para inmobiliarias con equipo. Recontactan la base con campañas de WhatsApp aprobadas por Meta, responden en WhatsApp, Instagram y Facebook, califican los leads y los cargan en el CRM (Tokko, KiteProp, Xintel). Incluye Centralito para cada asesor.`,
  provider: { '@id': `${SITE}/#org` },
  areaServed: [{ '@type': 'Country', name: 'Argentina' }, { '@type': 'Country', name: 'Uruguay' }],
  audience: { '@type': 'BusinessAudience', name: 'Inmobiliarias con equipo de asesores' },
  url: `${SITE}/inmobiliarias`,
});
const waText = `Hola, vengo de centralize.dev y quiero una propuesta para mi inmobiliaria (${v})`;
---
<Base title="Agentes de IA para inmobiliarias con equipo: campañas, respuestas y seguimiento | Centralize" description={`${v} recontacta tu base con mensajes aprobados por Meta, responde en WhatsApp, Instagram y Facebook, califica y carga el lead en tu CRM. Y armamos automatizaciones a medida para tu equipo.`} path="/inmobiliarias" active="inmobiliarias">
  <script slot="head" type="application/ld+json" set:html={ld} />
  <section class="page">
    <div class="wrap">
      <div class="page-head" style="max-width:860px">
        <p class="eyebrow">Para inmobiliarias con equipo</p>
        <h1><span class="only-d">Agentes de IA para tu inmobiliaria: campañas, respuestas y seguimiento, sobre tu CRM.</span><span class="only-m">La IA que habla con tus clientes, <em>sobre tu CRM.</em></span></h1>
        <p class="frase-fija">{v} trabaja con los clientes de tu inmobiliaria: responde, recontacta y califica tus leads. Es otro producto que Centralito, se contrata aparte y lo incluye para todo tu equipo.</p>
        <div class="cta-row" style="margin-top:22px" data-bar-sentinel><a class="btn btn-primary" href={demo} target="_blank" rel="noopener" data-cta="demo" data-section="inmobiliarias-hero">Agendar demo de {dur}</a><WaLink section="inmobiliarias" variant="btn-outline" label="Pedir propuesta por WhatsApp" text={waText} class="only-d" /></div>
      </div>
      <div class="prose">
        <h2>El problema</h2>
        <p>Los leads se enfrían en días y nadie hace el segundo, el tercero ni el cuarto seguimiento. Tu base tiene miles de contactos que consultaron una vez y quedaron ahí.</p>
        <h2>Los tres canales, con lo que hace cada uno hoy</h2>
        <ul>
          <li><strong>WhatsApp:</strong> campañas con templates aprobados por Meta, seguimiento hasta que responden, calificación HOT / WARM / COLD y carga al CRM. Conectás tu número en 15 minutos, sin cambiarlo.</li>
          <li><strong>Instagram:</strong> responde los mensajes directos y los comentarios sobre publicaciones.</li>
          <li><strong>Facebook:</strong> responde los mensajes directos de publicaciones y anuncios, con el mismo bot.</li>
        </ul>
        <h2>Cómo arranca</h2>
      </div>
      <div class="cols-3" style="margin-top:16px">
        <div class="step"><span class="n">1</span><b>Conectás tu WhatsApp</b><p>En 15 minutos, sin cambiar de número.</p></div>
        <div class="step"><span class="n">2</span><b>Armamos el bot sobre tu negocio</b><p>Con tus propiedades, tu tono y tus reglas de derivación. Lo probás con nosotros.</p></div>
        <div class="step"><span class="n">3</span><b>Sale a producción</b><p>Cuando pasó nuestras pruebas sobre tu negocio. Vos definís si el bot sigue acompañando después de derivar o se corre.</p></div>
      </div>
      <div class="prose">
        <h2>El panel</h2>
        <p>Bandeja de entrada, Campañas, Probar bot, Contactos, Integraciones (Tokko, KiteProp, Xintel), Equipo y Uso de WhatsApp. Ves cuánto gasta cada asesor en WhatsApp y le ponés un tope.</p>
        <h2>Centralito para todo el equipo</h2>
        <p>{v} incluye Centralito para cada asesor. Centralito trabaja para ellos: busca, ordena, tasa, arma y recuerda. Todo lo que le llega a un cliente lo manda el asesor.</p>
        <div style="margin:24px 0"><Proof which="ventas" /></div>
        {casos.map(c => <><h2>Un caso: {c.nombre}</h2><p>{c.resumen} <a class="link" href={`/casos/${c.slug}`}>Leer el caso de {c.nombre}</a></p></>)}
      </div>
      <div class="page-head" style="max-width:860px;margin-top:48px">
        <p class="eyebrow">A medida</p>
        <h2 class="h2-sec">¿Tu equipo hace a mano una tarea que no está acá? <em>La automatizamos con IA.</em></h2>
        <p class="lead">Conectamos lo que tu equipo ya usa: WhatsApp, su CRM, sus planillas. Armamos un agente que hace la tarea y rinde cuentas. Lo ves funcionar con tus datos antes de que lo use tu equipo.</p>
      </div>
      <div class="cols-2">
        <div class="step"><b>Una inmobiliaria del oeste del GBA</b><p>El informe de cada propiedad le llega solo al dueño cada martes: consultas, visitas y difusión de la semana, en PDF, desde el CRM, sin que nadie lo arme.</p></div>
        <div class="step"><b>Una casa de subastas</b><p>El WhatsApp de cada comercial espejado en un CRM a medida: ficha por vendedor, briefing diario y acceso del equipo por Centralito.</p></div>
      </div>
      <h3 class="h2-sec" style="margin-top:32px">Cómo trabajamos</h3>
      <div class="cols-3" style="margin-top:20px">
        <div class="step"><span class="n">1</span><b>Contanos la tarea</b><p>Qué hace hoy tu equipo a mano y dónde vive la información.</p></div>
        <div class="step"><span class="n">2</span><b>Prototipo con tus datos</b><p>Lo ves funcionar vos primero, con casos reales.</p></div>
        <div class="step"><span class="n">3</span><b>Sale cuando lo usa tu equipo</b><p>Con registro de lo que hizo y a quién le avisó.</p></div>
      </div>
      <div class="prose">
        <h2>Preguntas</h2>
        <details class="faq-d"><summary>¿Qué cobra Meta?</summary><p>Meta factura los mensajes aparte; para la mayoría hoy es cero o unos pocos dólares por mes.</p></details>
        <details class="faq-d"><summary>¿Cómo se presenta el bot y cuándo deriva?</summary><p>Se presenta con el nombre que vos definas y deriva a un asesor cuando el lead pide hablar con una persona, cuando califica como HOT o cuando vos lo pausás desde el panel.</p></details>
        <details class="faq-d"><summary>¿Hay permanencia?</summary><p>No. Propuesta en una demo de {dur}, sin permanencia.</p></details>
      </div>
      <div class="cta-row only-d" style="margin-top:40px"><a class="btn btn-primary" href={demo} target="_blank" rel="noopener" data-cta="demo" data-section="inmobiliarias-final">Agendar demo de {dur}</a><WaLink section="inmobiliarias" variant="btn-outline" label="Pedir propuesta por WhatsApp" text={waText} /></div>
    </div>
  </section>
  <MobileBar section="inmobiliarias" primary={{ href: demo, label: `Agendar demo de ${dur}`, cta: 'demo', external: true }} secondary={{ wa: true, label: 'WhatsApp', cta: 'whatsapp', text: waText }} />
</Base>
