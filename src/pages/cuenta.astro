---
import Base from '@/layouts/Base.astro';
import WaLink from '@/components/WaLink.astro';
import contact from '@/data/contact.json';
const c = contact.whatsapp_centralito;
const href = `https://wa.me/${c.e164}?text=${encodeURIComponent(c.texto_cuenta)}`;
---
<Base title="Mi cuenta | Centralize" description="Mirá el estado de tu suscripción a Centralito, cambiá la tarjeta o dala de baja." path="/cuenta">
  <section class="page">
    <div class="wrap">
      <div class="page-head">
        <p class="eyebrow">Mi cuenta</p>
        <h1>Gestioná tu suscripción <em>desde WhatsApp</em>.</h1>
        <p class="lead">Sin llamadas ni formularios. Desde un link personal podés hacer todo esto:</p>
      </div>
      <div class="cuenta">
        <ul class="cuenta-list">
          <li><b>Ver el estado</b> de tu suscripción y la fecha del próximo cobro.</li>
          <li><b>Cambiar la tarjeta</b> con la que pagás.</li>
          <li><b>Darte de baja</b> cuando quieras. También es el botón de arrepentimiento.</li>
        </ul>
        <a class="btn btn-primary btn-block cuenta-cta" href={href} target="_blank" rel="noopener" data-cta="cuenta" data-section="cuenta">Gestionar mi suscripción</a>
        <p class="cuenta-nota">Se abre WhatsApp con el mensaje “Mi cuenta” listo para enviar. Centralito te responde con un link personal para gestionarla. El link es solo para vos: Centralito se lo manda únicamente al titular de la suscripción.</p>
        <div class="card cuenta-soporte">
          <h2>¿No tenés acceso a ese WhatsApp?</h2>
          <p>Escribile al soporte y lo resolvemos a mano.</p>
          <WaLink section="cuenta-soporte" variant="btn" label="Escribir al soporte por WhatsApp" text="Hola, quiero gestionar mi suscripción de Centralito pero no tengo acceso al WhatsApp con el que la contraté" class="btn-block" />
        </div>
        <p class="cuenta-nota">Condiciones de la baja y del arrepentimiento: <a class="link" href="/terminos">Términos</a>.</p>
      </div>
    </div>
  </section>
</Base>
