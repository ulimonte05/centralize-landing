---
import Base from '@/layouts/Base.astro';
import WaLink from '@/components/WaLink.astro';
import { priceLine, guarantee } from '@/lib/pricing';
export const prerender = true;
const ar = priceLine('AR');
const api = (import.meta.env.PUBLIC_BILLING_API_URL || 'https://api.centralize.dev').trim();
const incluye = [
  'Un asistente que opera tu CRM inmobiliario: le escribís por WhatsApp como a un colega.',
  'Integrado con Tokko. ¿Usás otro CRM? Lo conectamos para vos.',
  'Te arma el resumen del día, busca en tu cartera y te prepara fichas y tasaciones.',
  'Pide tu OK antes de cambiar algo y te deja registro de lo que hizo.',
];
---
<Base title="Probá Centralito 7 días gratis | Centralize" description={`Probá Centralito ${ar.trialDays} días gratis, sin cobro hoy. Un asistente que opera tu CRM inmobiliario desde WhatsApp.`} path="/contratar" nav="min" active="contratar">
  <section class="page">
    <div class="wrap">
      <div class="page-head">
        <p class="eyebrow">Centralito</p>
        <h1>Probalo <em>{ar.trialDays} días gratis</em>.</h1>
        <p class="lead">Un asistente que opera tu CRM inmobiliario desde WhatsApp. Cargás tu medio de pago en el paso siguiente y no se cobra hoy.</p>
      </div>
      <div class="contratar-grid">
        <div class="card contratar-card" data-contratar data-api={api}>
          <p class="mono up">Qué incluye</p>
          <ul class="contratar-lista">{incluye.map(t => <li><span class="tick" aria-hidden="true"></span>{t}</li>)}</ul>
        </div>
        <div class="card contratar-card contratar-pago">
          <p class="mono up">Tu plan</p>
          <p class="contratar-gratis"><b>{ar.trialDays} días gratis</b></p>
          <p class="contratar-precio" data-price aria-live="polite">Después {ar.promo} al mes por {ar.promoMonths} meses, y {ar.list} al mes.</p>
          <p class="contratar-pais"><span data-country-label>Precios para Argentina.</span> <button type="button" class="link-btn" data-country-toggle>¿No estás en Argentina?</button></p>
          <p class="plan-sub muted">{ar.trialDays} días gratis · No se cobra hoy · Te avisamos antes de cobrar</p>
          <p class="plan-cond mono up">Sin permanencia · {guarantee}</p>
          <button type="button" class="btn btn-primary btn-block" data-start data-cta="contratar" data-section="contratar">Empezar mi prueba</button>
          <p class="contratar-error" role="alert" data-error hidden>No pudimos abrir el pago. Probá de nuevo o escribinos <WaLink section="contratar-error" label="por WhatsApp" /></p>
          <p class="legal-mini">Al continuar aceptás los <a class="link" href="/terminos">Términos</a> y la <a class="link" href="/privacidad">Privacidad</a>.</p>
        </div>
      </div>
    </div>
  </section>
  <script>import '@/islands/checkout';</script>
</Base>
