---
import Base from '@/layouts/Base.astro';
import Chat from '@/components/Chat.astro';
import { priceLine, guarantee } from '@/lib/pricing';
import contact from '@/data/contact.json';
import { SCENES, ALL_IDS } from '@/lib/scenes';
export const prerender = true;
const q = Astro.url.searchParams;
const pedidoId = q.get('pedido') && SCENES[q.get('pedido')!] ? q.get('pedido')! : '';
const pais = q.get('pais') === 'uy' ? 'uy' : 'ar';
const precio = priceLine(pais === 'uy' ? 'UY' : 'AR');
const sugeridas = ['resumen-del-dia', 'buscar-cartera', 'tasacion-acm'];
const v = contact.productos.ventas.nombre;
---
<Base title="Empezar con Centralito | Centralize" description="Activá tu Centralito: dejás tus datos, te escribimos y le mandás el primer pedido por WhatsApp." path="/empezar" nav="min" active="empezar" noindex>
  <section class="page">
    <div class="wrap">
      <a class="contexto" href={contact.calcom.url} target="_blank" rel="noopener" data-cta="demo" data-section="empezar"><span class="only-d">¿Venías por {v}, la IA que habla con tus clientes? </span><span class="only-m">¿Buscabas {v}? </span><b>Eso arranca con una demo de {contact.calcom.duracion.replace(' minutos', ' min')} →</b></a>
      <div class="page-head">
        <p class="eyebrow"><span class="only-d">Alta en 3 pasos · <b>1 Tus datos</b> · 2 Activación · 3 Listo</span><span class="only-m">Paso 1 de 3 · Tus datos</span></p>
        <h1>Activá tu <em>Centralito</em>.</h1>
        <p class="lead"><span class="only-d">Te lo activa una persona del equipo. Te escribimos {contact.sla_alta} por WhatsApp y por email cuando ya te pueda responder.</span><span class="only-m">Te lo activa una persona del equipo y te avisa {contact.sla_alta_corto} por WhatsApp.</span></p>
      </div>
      <div class="empezar-grid">
        <form class="form" method="post" action="/api/empezar" data-empezar>
          <input type="hidden" name="origen" value="" data-origen>
          <input type="hidden" name="pedido_id" value={pedidoId}>
          <div class="field">
            <label for="pedido">Tu primer pedido</label>
            <textarea id="pedido" name="pedido" rows="3" placeholder="Escribilo como se lo dirías a un colega"></textarea>
            <div class="seg-group" data-sugeridas>{sugeridas.map(id => <button type="button" class="pill" data-sug={SCENES[id].wa_text}>{SCENES[id].chip}</button>)}</div>
            <script type="application/json" id="wa-map" set:html={JSON.stringify(Object.fromEntries(ALL_IDS.map(id => [id, SCENES[id].wa_text])))} />
            <small>Después del alta te queda listo para mandarlo tal cual.</small>
          </div>
          <div class="field"><label for="nombre">Nombre y apellido</label><input id="nombre" name="nombre" required autocomplete="name"></div>
          <div class="field"><label for="inmo">Inmobiliaria</label><input id="inmo" name="inmobiliaria" required autocomplete="organization"></div>
          <div class="field"><label for="tel">WhatsApp</label><div class="row"><select name="prefijo" aria-label="País del número"><option value="54">+54 AR</option><option value="598">+598 UY</option><option value="">otro</option></select><input id="tel" name="whatsapp" type="tel" required inputmode="tel" autocomplete="tel-national" placeholder="9 11 5555 0000"></div><small>Es el número desde el que le vas a escribir. Lo usa para reconocerte.</small></div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email"><small>Para la factura y la confirmación.</small></div>
          <div class="field"><span class="label" id="eq-l" style="font-weight:600">¿Cuántos son en el equipo?</span><div class="seg-group" role="radiogroup" aria-labelledby="eq-l">{['Solo yo', '2 a 5', '6 a 15', 'Más de 15'].map((t, i) => <label><input type="radio" name="equipo" value={t} checked={i === 0}>{t}</label>)}</div></div>
          <div class="field"><label for="tokko">Usuario de Tokko a tu nombre</label><input id="tokko" name="tokko_usuario" autocomplete="off" placeholder="opcional, lo podés cargar después"><small>Si no lo tenés, lo pedís en Tokko y lo cargás después; sin esto Centralito no puede entrar a tu CRM. Acá no te pedimos la contraseña.</small></div>
          <input type="hidden" name="plan" value="centralito"><div class="field"><span class="label" style="font-weight:600">País</span><div class="seg-group" role="radiogroup" aria-label="País"><label><input type="radio" name="pais" value="ar" checked={pais === 'ar'}>Argentina</label><label><input type="radio" name="pais" value="uy" checked={pais === 'uy'}>Uruguay</label></div></div>
          <button class="btn btn-primary btn-block" type="submit" data-cta="checkout" data-section="centralito">Quiero activarlo</button>
          <p class="legal-mini">No se cobra nada ahora. Te escribimos {contact.sla_alta} para activarlo. Al enviar aceptás los <a class="link" href="/terminos">Términos</a> y la <a class="link" href="/privacidad">Privacidad</a>.</p>
        </form>
        <aside class="recibo card">
          <p class="mono up">Lo que vas a recibir</p>
          <ul>
            <li><b>Plan</b><span>{precio.trialDays} días gratis, después {precio.promo} al mes por {precio.promoMonths} meses y {precio.list} al mes</span></li>
            <li><b>Recibís</b><span>un Centralito en tu WhatsApp, sobre tu Tokko</span></li>
            <li><b>Podés</b><span>cancelar con un mensaje. {guarantee}</span></li>
            <li><b>Te activa</b><span>una persona del equipo, {contact.sla_alta}</span></li>
          </ul>
          <div class="chips"><span class="chip">Pide tu OK antes</span><span class="chip">Te dice cuánto leyó</span><span class="chip">Queda registrado</span></div>
          <div class="recibo-chat" style="margin-top:20px"><Chat instance="empezar" scene={pedidoId || 'resumen-del-dia'} mode="hero" /></div>
        </aside>
      </div>
    </div>
  </section>
  <script>
    try { const o = sessionStorage.getItem('centralize.ref'); if (o) (document.querySelector('[data-origen]') as HTMLInputElement).value = o; } catch {}
    { const q = new URLSearchParams(location.search); const map = JSON.parse(document.getElementById('wa-map')!.textContent || '{}'); const id = q.get('pedido') || '';
      if (map[id]) { (document.getElementById('pedido') as HTMLTextAreaElement).value = map[id]; (document.querySelector('input[name=pedido_id]') as HTMLInputElement).value = id; }
      const pais = q.get('pais'); const el = document.querySelector(`input[name=pais][value="${pais}"]`) as HTMLInputElement | null; if (el) el.checked = true; }
    document.querySelector('[data-sugeridas]')?.addEventListener('click', e => { const b = (e.target as HTMLElement).closest('[data-sug]') as HTMLElement | null; if (!b) return; (document.getElementById('pedido') as HTMLTextAreaElement).value = b.dataset.sug || ''; });
    document.querySelector('[data-empezar]')?.addEventListener('submit', () => { try { (window as any).va?.('event', { name: 'checkout_start', data: { cta: 'centralito', section: (document.querySelector('input[name=pais]:checked') as HTMLInputElement)?.value } }); } catch {} });
  </script>
</Base>
<style>.recibo-chat .chat{height:420px;max-width:none}@media (max-width:1023px){.recibo-chat{display:none}}</style>
