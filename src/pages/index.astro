---
import Base from '@/layouts/Base.astro';
import HomeHero from '@/components/HomeHero.astro';
import HomeBlocks from '@/components/HomeBlocks.astro';
import { OFFER } from '@/lib/offer';
import { faqItems } from '@/lib/faq';
import { ORG, WEBSITE, centralitoApp, faqPage, graph } from '@/lib/schema';
const description = `Centralito es el asistente de IA para inmobiliarias que opera tu CRM desde WhatsApp: tasa con comparables de la Red Tokko, edita fichas, arma el PDF de una propiedad y te recuerda los seguimientos. Para asesores de Argentina y Uruguay. ${OFFER.gratis}${OFFER.mode === 'free_month' ? ', sin tarjeta' : ''}.`;
const ld = graph(ORG, WEBSITE, centralitoApp(description), faqPage(faqItems()));
---
<Base title="Centralito: asistente de IA para inmobiliarias por WhatsApp | Centralize" description={description} path="/" active="home">
  <script slot="head" type="application/ld+json" set:html={ld} />
  <HomeHero />
  <HomeBlocks />
  <script src="@/islands/chat-engine.ts"></script>
</Base>
