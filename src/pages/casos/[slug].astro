---
import Base from '@/layouts/Base.astro';
import WaLink from '@/components/WaLink.astro';
import casos from '@/data/casos.json';
import contact from '@/data/contact.json';
import { ORG, SITE, graph } from '@/lib/schema';

// Un caso por entrada de casos.json; solo se publican los que tienen autorización escrita.
export function getStaticPaths() {
  return casos.map(c => ({ params: { slug: c.slug }, props: { caso: c } }));
}
type Caso = Omit<(typeof casos)[number], 'cita' | 'corte_visible'> & { cita: { texto: string; nombre: string; cargo: string } | null; corte_visible?: string };
const { caso } = Astro.props as { caso: Caso };
const ventas = contact.productos.ventas.nombre;
const PRODUCTO: Record<string, { nombre: string; href: string }> = {
  ventas: { nombre: ventas, href: '/inmobiliarias' },
  centralito: { nombre: 'Centralito', href: '/' },
};
const path = `/casos/${caso.slug}`;
const dur = contact.calcom.duracion.replace(' minutos', ' min');
const lugar = `${caso.ciudades.join(' y ')}, ${caso.pais}`;
const ld = graph(ORG, {
  '@type': 'Article',
  '@id': `${SITE}${path}#caso`,
  headline: caso.titulo,
  description: caso.resumen,
  datePublished: caso.publicado,
  inLanguage: 'es',
  url: `${SITE}${path}`,
  author: { '@id': `${SITE}/#org` },
  publisher: { '@id': `${SITE}/#org` },
  about: { '@type': 'RealEstateAgent', name: caso.nombre, areaServed: caso.ciudades.map(c => ({ '@type': 'City', name: c })) },
  mentions: caso.productos.map(p => ({ '@type': p === 'ventas' ? 'Service' : 'SoftwareApplication', name: PRODUCTO[p].nombre, url: `${SITE}${PRODUCTO[p].href}` })),
}, {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Centralize', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: `${ventas} para inmobiliarias`, item: `${SITE}/inmobiliarias` },
    { '@type': 'ListItem', position: 3, name: `Caso ${caso.nombre}`, item: `${SITE}${path}` },
  ],
});
---
<Base title={`${caso.titulo} | Centralize`} description={caso.resumen} path={path} active="inmobiliarias">
  <script slot="head" type="application/ld+json" set:html={ld} />
  <article class="page caso">
    <div class="wrap">
      <nav class="migas" aria-label="Ruta"><a href="/inmobiliarias">{ventas}</a> / <span>Caso {caso.nombre}</span></nav>
      <header class="page-head">
        <h1>{caso.titulo}</h1>
        <p class="lead">{caso.resumen}</p>
      </header>

      <div class="caso-grid">
        <div class="prose">
          <ul class="caso-cifras">
            {caso.cifras.map(c => <li><b>{c.valor}</b> {c.detalle}</li>)}
          </ul>
          <h2>Lo que pasaba</h2>
          <p>{caso.problema}</p>
          <h2>Qué hicieron</h2>
          {caso.que_hicieron.map(q => <p>{q.texto} <a class="link" href={PRODUCTO[q.producto].href}>Ver {PRODUCTO[q.producto].nombre}</a></p>)}
          <h2>El resultado</h2>
          <p>{caso.resultado}</p>
          {caso.cita && <blockquote class="caso-cita"><p>“{caso.cita.texto}”</p><footer>{caso.cita.nombre}, {caso.cita.cargo} en {caso.nombre}</footer></blockquote>}
          <p class="caso-fecha">Publicado el {caso.publicado_visible} con autorización de {caso.nombre}. Las cifras son las de su cuenta en Centralize{caso.corte_visible && <>, con corte al {caso.corte_visible}</>}.</p>
        </div>

        <aside class="caso-ficha" aria-label={`Datos de ${caso.nombre}`}>
          <dl>
            <div><dt>Inmobiliaria</dt><dd>{caso.nombre}</dd></div>
            <div><dt>Dónde</dt><dd>{lugar}</dd></div>
            <div><dt>Equipo</dt><dd>{caso.equipo}</dd></div>
            <div><dt>CRM</dt><dd>{caso.crm}</dd></div>
            <div><dt>Con Centralize desde</dt><dd>{caso.desde}</dd></div>
            <div><dt>Usa</dt><dd>{caso.productos.map(p => PRODUCTO[p].nombre).join(' y ')}</dd></div>
          </dl>
          <a class="btn btn-primary btn-block" href={contact.calcom.url} target="_blank" rel="noopener" data-cta="demo" data-section={`caso-${caso.slug}`}>Agendar demo de {dur}</a>
          <WaLink section={`caso-${caso.slug}`} label="Preguntar por WhatsApp" text={`Hola, vengo del caso de ${caso.nombre} en centralize.dev y quiero algo así para mi inmobiliaria`} />
        </aside>
      </div>
    </div>
  </article>
</Base>
