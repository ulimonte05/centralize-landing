---
import Base from '@/layouts/Base.astro';
import contact from '@/data/contact.json';
import plans from '@/data/plans.json';
import MobileBar from '@/components/MobileBar.astro';
import { SCENES, ALL_IDS } from '@/lib/scenes';
export const prerender = true;
const wa = `https://wa.me/${contact.whatsapp_ventas.e164}?text=${encodeURIComponent('Hola, acabo de dejar mis datos para activar Centralito [web-gracias]')}`;
const waDemora = `https://wa.me/${contact.whatsapp_ventas.e164}?text=${encodeURIComponent('Hola, dejé mis datos para Centralito y todavía no me escribieron [web-gracias-demora]')}`;
---
<Base title="Listo | Centralize" description="Tu Centralito se activa en el próximo día hábil." path="/gracias" nav="min" noindex>
  <section class="page">
    <div class="wrap">
      <div class="page-head">
        <p class="eyebrow"><span class="only-d">Alta en 3 pasos · 1 Tus datos · <b>2 Activación</b> · 3 Listo</span><span class="only-m">Paso 2 de 3 · Activación</span></p>
        <h1>Listo. Tu Centralito se activa <em>{contact.sla_alta_corto}</em>.</h1>
        <p class="lead">Te escribimos por WhatsApp y por email cuando ya te pueda responder. No hace falta que vuelvas a esta página.</p>
      </div>
      <div class="empezar-grid">
        <div>
          <ol class="pasos" style="font-size:16px;color:var(--ink)">
            <li>Te escribimos.</li>
            <li>Nos pasás tu usuario de Tokko.</li>
            <li>Te avisamos que ya responde.</li>
            <li>Le mandás tu primer pedido (lo guardamos acá).</li>
          </ol>
          <div class="estado" aria-label="Estado del alta">
            <span class="ok"><i></i>Datos recibidos</span>
            <span class="curso"><i></i>Alta en curso: una persona del equipo está dando de alta tu número</span>
            <span><i></i>Listo para escribirle</span>
          </div>
          <p class="mono">Si pasó {contact.sla_alta} y no te escribimos, <a class="link" href={waDemora} target="_blank" rel="noopener" data-wa data-section="gracias-demora" data-e164={contact.whatsapp_ventas.e164} data-visible={contact.whatsapp_ventas.visible}>tocá acá</a>.</p>
          <div class="cta-row" style="margin-top:24px" data-bar-sentinel><a class="btn btn-primary" href={wa} target="_blank" rel="noopener" data-wa data-section="gracias" data-e164={contact.whatsapp_ventas.e164} data-visible={contact.whatsapp_ventas.visible}>Hablar con el equipo</a><a class="link" href="/terminos">Ver los Términos</a></div>
          {plans.cobro && <p class="legal-mini" style="margin-top:20px"><a class="link" href="/contacto?tema=arrepentimiento">Botón de arrepentimiento</a> · <a class="link" href="/contacto?tema=baja">Dar de baja</a></p>}
        </div>
        <aside class="recibo card">
          <p class="mono up">Registro</p>
          <ul>
            <li><b>Recibido</b><span data-g="plan">tus datos y el plan elegido</span></li>
            <li><b>Primer pedido</b><span data-g="pedido">lo guardamos para cuando te active</span></li>
            <script type="application/json" id="wa-map" set:html={JSON.stringify(Object.fromEntries(ALL_IDS.map(id => [id, SCENES[id].wa_text])))} />
            <li><b>Mensajes a clientes</b><span>0</span></li>
          </ul>
        </aside>
      </div>
      <h2 class="h2-sec">Mientras tanto, qué le podés pedir el primer día</h2>
      <details class="m-fold" open><summary class="pill">Ver los 15 pedidos</summary><ul class="pedidos-lista">
        {ALL_IDS.map(id => <li><b>{SCENES[id].chip}</b>{SCENES[id].wa_text} <button type="button" class="link-btn" data-copy={SCENES[id].wa_text} style="color:var(--green-text)">Copiar</button></li>)}
      </ul></details>
    </div>
  </section>
  <MobileBar section="gracias" primary={{ wa: true, label: 'Hablar con el equipo', cta: 'whatsapp', text: 'Hola, acabo de dejar mis datos para activar Centralito' }} />
  <script>
    const q = new URLSearchParams(location.search);
    const pedido = q.get('pedido'); const plan = q.get('plan');
    if (plan) (document.querySelector('[data-g=plan]') as HTMLElement).textContent = `tus datos y el plan ${plan}`;
    const map = JSON.parse(document.getElementById('wa-map')!.textContent || '{}');
    if (pedido && map[pedido]) (document.querySelector('[data-g=pedido]') as HTMLElement).textContent = `“${map[pedido]}”`;
    try { (window as any).va?.('event', { name: 'checkout_success', data: { cta: plan || '', section: q.get('pais') || '' } }); } catch {}
    document.addEventListener('click', e => { const b = (e.target as HTMLElement).closest('[data-copy]') as HTMLElement | null; if (!b) return; navigator.clipboard?.writeText(b.dataset.copy || ''); b.textContent = 'Copiado'; });
  </script>
</Base>
