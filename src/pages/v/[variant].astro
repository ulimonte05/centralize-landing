---
import Base from '@/layouts/Base.astro';
import Home from '@/components/Home.astro';
export function getStaticPaths() { return [{ params: { variant: 'simple' } }, { params: { variant: 'carta' } }, { params: { variant: 'un-dia' } }, { params: { variant: 'catalogo' } }]; }
const { variant } = Astro.params as { variant: 'simple' | 'carta' | 'un-dia' | 'catalogo' };
const names = { simple: 'D · Una pantalla, quince pedidos', carta: 'A · La carta que ya trabaja', 'un-dia': 'B · Un día con Centralito', catalogo: 'C · Catálogo vivo' };
---
<Base title={`${names[variant]} | Centralize (variante de diseño)`} description="Variante de diseño de la nueva centralize.dev, para comparar." path={`/v/${variant}`} noindex active="home">
  <Home variant={variant} />
</Base>
