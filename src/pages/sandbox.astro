---
import Base from '@/layouts/Base.astro';
import Chat from '@/components/Chat.astro';
import { SCENES, TOTAL } from '@/lib/scenes';
import { esc } from '@/lib/render';
import { CORTO as corto, FAMILIAS as familias, ORDEN as orden } from '@/lib/pedidos';
const chips = orden.map(id => `<button type="button" class="pill" data-scene-trigger="${id}" data-target="sandbox" aria-pressed="${id === 'resumen-del-dia'}">${esc(corto[id])}</button>`).join('');
---
<Base title="Sandbox de Centralito | Centralize" description="Probá los 15 pedidos de Centralito en un chat de ejemplo. Escribí lo que le pedirías y mirá qué hace." path="/sandbox" nav="min" noindex>
  <section class="sandbox" aria-labelledby="sb-h">
    <div class="wrap sb-grid">
      <aside class="sb-side">
        <div>
          <p class="eyebrow">Sandbox · ejemplo</p>
          <h1 id="sb-h">Pedile algo a Centralito.</h1>
          <p class="lead" style="margin-top:8px">Escribí en el chat como lo dirías, o tocá un pedido. Caro, sus clientes y las cifras son de demostración.</p>
        </div>
        <p class="mono" data-vistos>Viste 0 de {TOTAL} pedidos</p>
        <div class="sb-list">
          {familias.map(f => <div class="sb-fam"><b>{f.nombre}</b>{f.ids.map(id => <button type="button" class="sb-item" data-scene-trigger={id} data-target="sandbox" aria-pressed={id === 'resumen-del-dia' ? 'true' : 'false'}>{corto[id]}</button>)}</div>)}
        </div>
        <a class="btn btn-primary" href="/contratar" data-cta="contratar" data-section="sandbox">Quiero uno en mi WhatsApp</a>
      </aside>
      <div class="sb-main">
        <div class="sb-top"><h1>Pedile algo a Centralito</h1><button type="button" class="pill" data-open-sheet>Los 15 pedidos</button></div>
        <Chat instance="sandbox" scene="resumen-del-dia" mode="hero" input={true} chips={chips} />
        <p class="sb-hint">Ejemplo con nombres y cifras de demostración · Lo que sale hacia un cliente lo mandás vos · <a class="link" href="/contratar">Quiero uno en mi WhatsApp</a></p>
      </div>
    </div>
    <dialog class="sb-sheet" data-sheet>
      <h2>Los 15 pedidos <button type="button" class="close" data-close-sheet aria-label="Cerrar">×</button></h2>
      {familias.map(f => <div class="sb-fam"><b>{f.nombre}</b>{f.ids.map(id => <button type="button" class="sb-item" data-scene-trigger={id} data-target="sandbox">{corto[id]}</button>)}</div>)}
    </dialog>
  </section>
  <script>
    const sheet = document.querySelector('[data-sheet]') as HTMLDialogElement | null;
    document.querySelector('[data-open-sheet]')?.addEventListener('click', () => sheet?.showModal());
    document.querySelector('[data-close-sheet]')?.addEventListener('click', () => sheet?.close());
    sheet?.addEventListener('click', e => { if (e.target === sheet) sheet.close(); });
  </script>
  <script src="@/islands/chat-engine.ts"></script>
</Base>
