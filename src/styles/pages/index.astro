---
import Base from '@/layouts/Base.astro';
import Home from '@/components/Home.astro';
const variant = (import.meta.env.PUBLIC_VARIANT || 'carta') as 'carta' | 'un-dia' | 'catalogo';
const ld = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', name: 'Centralize', url: 'https://centralize.dev/', logo: 'https://centralize.dev/assets/centralize-mark-black.png', sameAs: ['https://www.linkedin.com/company/centralize-ai', 'https://www.instagram.com/centralize.dev/'] },
  { '@type': 'WebSite', name: 'Centralize', alternateName: 'Centralito', url: 'https://centralize.dev/' },
] };
---
<Base title="Centralito: tu colega de IA en WhatsApp para operar Tokko | Centralize" description="Centralito es un colega de IA que vive en tu WhatsApp: entra a tu Tokko, busca, segmenta, arma tasaciones y fichas, y te deja todo listo para que lo mandes vos. Para inmobiliarias de Argentina y Uruguay." path="/" active="home">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Home variant={variant} />
</Base>
