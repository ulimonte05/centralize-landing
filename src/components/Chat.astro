---
import { SCENES } from '@/lib/scenes';
import { renderChatShell, renderSceneFinal } from '@/lib/render';
interface Props { instance: 'hero' | 'dia' | 'empezar' | 'sandbox'; scene: string; mode: 'hero' | 'panel'; panel?: string; class?: string; input?: boolean; chips?: string; controls?: boolean }
const { instance, scene: id, mode, panel, class: classes = '', input = false, chips = '', controls = true } = Astro.props;
const scene = SCENES[id];
const html = renderChatShell({ instance, mode, etiqueta: scene.etiqueta, inner: renderSceneFinal(scene, mode), sceneId: scene.id, classes, panel, input, chips, controls });
---
<Fragment set:html={html} />
