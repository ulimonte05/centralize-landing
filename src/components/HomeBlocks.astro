---
import PlanCard from '@/components/PlanCard.astro';
import WaLink from '@/components/WaLink.astro';
import claims from '@/data/claims.json';
import contact from '@/data/contact.json';
import casos from '@/data/casos.json';
import { priceLine } from '@/lib/pricing';
import { faqItems } from '@/lib/faq';
import { OFFER } from '@/lib/offer';
import { CORTO, FAMILIAS, FUERA_DEL_PLAN } from '@/lib/pedidos';
import { SCENES, TOTAL } from '@/lib/scenes';
// "Tasar y armar" va primero: es el diferencial (tasación con comparables de la Red Tokko).
const PRIMERO = 'Tasar y armar';
const ordenFam = [...FAMILIAS].sort((a, b) => Number(b.nombre === PRIMERO) - Number(a.nombre === PRIMERO));
// Fuera de la home: pedidos que el plan individual (asesor_ss) no tiene. El sandbox los sigue mostrando.
const rail = ordenFam.flatMap(f => f.ids.filter(id => !FUERA_DEL_PLAN.includes(id)).map(id => ({ id, fam: f.nombre, corto: CORTO[id] })));
// Desktop: el mensaje tal cual lo escribe el asesor en cada escena, con el antes y el después.
const pedidos = ordenFam.map(f => ({
  nombre: f.nombre,
  // Dos por familia en la home; el resto queda en el sandbox.
  items: f.ids.filter(id => !FUERA_DEL_PLAN.includes(id)).slice(0, 2).map(id => {
    const s = SCENES[id];
    return { id, texto: s.mensajes.find(m => m.de === 'asesor')?.texto ?? CORTO[id], antes: s.antes, despues: s.despues };
  }),
}));
const pasos = [
  OFFER.paso1,
  { t: 'Mandás tu código por WhatsApp', d: 'Después de anotarte te damos un código. Se lo mandás a Centralito desde tu WhatsApp y queda activo en tu número.' },
  { t: 'Conectás tu CRM', d: 'Le pasás un usuario de Tokko a tu nombre y ya le podés pedir cosas. Queda guardado aparte, no aparece en el chat y lo revocás cuando quieras.' },
];
const ar = priceLine('AR');
const items = faqItems();
---
<section class="block" id="pedidos" aria-labelledby="ped-h">
  <div class="wrap">
    <div class="block-head"><h2 id="ped-h">Le escribís como a un colega. Lo hace en tu CRM.</h2><p class="lead only-d">Son los pedidos que los asesores le hacen, escritos como los mandan. Cada uno se puede probar en el sandbox con nombres y cifras de ejemplo.</p><p class="lead only-m">Tocá uno y miralo en el sandbox.</p></div>
    <div class="pedidos-home only-d">
      {pedidos.map(f => (
        <div class="ped-fam">
          <h3>{f.nombre}</h3>
          <ul>
            {f.items.map(p => (
              <li>
                <a class="ped" href={`/sandbox#carta-${p.id}`} data-cta="sandbox" data-section="pedidos">
                  <span class="ped-msg">{p.texto}</span>
                  <span class="ped-antes"><s>{p.antes}</s><span>{p.despues}</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="ped-mas"><a class="link" href="/sandbox" data-cta="sandbox" data-section="pedidos">Ver los {TOTAL} pedidos en el sandbox</a></p>
    </div>
  </div>
  <div class="rail-m only-m" data-rail-m>
    {rail.map((r, i) => <a class="rail-card" href={`/sandbox#carta-${r.id}`} data-cta="sandbox" data-section="rail" style={`--i:${i}`}><b>{r.fam}</b><span>{r.corto}</span><i aria-hidden="true">→</i></a>)}
    <a class="rail-card rail-end" href="/sandbox" data-cta="sandbox" data-section="rail"><span>Probalos con tu propio texto</span><i aria-hidden="true">→</i></a>
  </div>
  <p class="rail-dots only-m" aria-hidden="true"><span></span><span></span><span></span><span></span></p>
</section>
<section class="block" id="como" aria-labelledby="como-h">
  <div class="wrap como-grid">
    <div class="block-head"><h2 id="como-h">Se activa desde el celular, en tres pasos.</h2></div>
    <ol class="pasos-home">
      {pasos.map(p => <li><b>{p.t}</b><p>{p.d}</p></li>)}
    </ol>
  </div>
</section>
<section class="block" id="confianza" aria-labelledby="conf-h">
  <div class="wrap">
    <div class="block-head"><h2 id="conf-h">Vos decidís qué sale y a quién.</h2><p class="lead">{claims.centralito.pedidos}, contados <span class="nowrap">{claims.corte_visible}</span>.{casos[0] && <> <a class="link" href={`/casos/${casos[0].slug}`}>Mirá el caso de {casos[0].nombre}</a>.</>}</p></div>
    <dl class="reglas">
      <div><dt>Trabaja en Tokko</dt><dd>Lee y edita tu cartera y tus leads, y busca en la Red Tokko. ¿Usás otro CRM? Lo conectamos para vos.</dd></div>
      <div><dt>Nunca les escribe a tus clientes</dt><dd>Te deja el texto o el PDF listo y lo mandás vos desde tu WhatsApp.</dd></div>
      <div><dt>Te pide el OK antes de tocar muchas fichas</dt><dd>Para un cambio en lote primero te muestra el plan, y te dice cuántas fichas leyó.</dd></div>
    </dl>
    {claims.showClientLogos && <div class="clientes"><p class="clientes-t">Inmobiliarias que ya trabajan con Centralize</p><ul>{claims.clientLogos.map(c => <li>{c}</li>)}</ul></div>}
  </div>
</section>
<section class="block" id="precio" aria-labelledby="pre-h">
  <div class="wrap precio-grid">
    <div class="block-head"><h2 id="pre-h">{`${OFFER.gratis}. Después, ${ar.promo} al\u00a0mes por ${ar.promoMonths}\u00a0meses.`}</h2><p class="lead">Precio de lanzamiento para los primeros asesores. Te das de baja con un mensaje.</p></div>
    <PlanCard section="precio" />
  </div>
</section>
<section class="block" id="faq" aria-labelledby="faq-h">
  <div class="wrap">
    <div class="block-head"><h2 id="faq-h">Lo que preguntan antes de probarlo.</h2></div>
    <div class="faq-cols">{[items.slice(0, Math.ceil(items.length / 2)), items.slice(Math.ceil(items.length / 2))].map(col => <div>{col.map(it => <details class="faq-d" id={`faq-${it.id}`}><summary>{it.q}</summary><p>{it.a}{it.link && <> <a class="link" href={it.link.href} data-cta={it.link.cta} data-section="faq">{it.link.label}</a></>}</p></details>)}</div>)}</div>
    <p class="faq-more">¿Otra pregunta? <WaLink section="faq" /></p>
  </div>
</section>
<section class="block final" id="final" aria-labelledby="fin-h">
  <div class="wrap">
    <h2 id="fin-h">Mandale el primer pedido hoy.</h2>
    <a class="btn btn-primary" href="/contratar" data-cta="contratar" data-section="final">{OFFER.cta}</a>
    <p class="final-inmo"><a class="link" href="/inmobiliarias" data-cta="inmobiliarias" data-section="final">¿Tenés una inmobiliaria con equipo? Mirá {contact.productos.ventas.nombre}</a></p>
  </div>
</section>
