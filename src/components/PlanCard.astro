---
import contact from '@/data/contact.json';
import { priceLine, guarantee } from '@/lib/pricing';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const ar = priceLine('AR');
const usd = priceLine('UY');
---
<div class={`plan-card card ${compact ? 'compact' : ''}`}>
  <p class="plan-nombre">Centralito</p>
  <p class="plan-neto"><b>{ar.trialDays} días gratis</b></p>
  <p class="plan-total muted">Después {ar.promo} al mes por {ar.promoMonths} meses, y {ar.list} al mes.</p>
  <p class="plan-total muted">Fuera de Argentina: {usd.promo} al mes por {usd.promoMonths} meses, y {usd.list} al mes.</p>
  <p class="mono up plan-cond">Sin permanencia · {guarantee}</p>
  <a class="btn btn-primary btn-block" href="/empezar" data-cta="empezar" data-section="precio">Quiero activarlo</a>
  <p class="plan-sub muted">Te escribimos {contact.sla_alta} para activarlo.</p>
</div>
