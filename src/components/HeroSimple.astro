---
import Chat from '@/components/Chat.astro';
import WaLink from '@/components/WaLink.astro';
import PriceLine from '@/components/PriceLine.astro';
import Proof from '@/components/Proof.astro';
import { SCENES, TOTAL } from '@/lib/scenes';
// 15 pedidos agrupados por familia (ids = datos/capabilities.json); etiquetas cortas para que entren en una pantalla
const corto: Record<string, string> = { 'resumen-del-dia': 'Qué entró anoche', 'cargar-lead': 'Cargá un lead', 'quien-consulto': '¿Quién consultó por Thames 400?', 'rutina-leads-sin-cargar': 'Avisame si hay leads sin atender', 'buscar-cartera': 'Buscá en tu cartera', 'buscar-red': '3 opciones en la Red Tokko', 'quien-busca-algo-asi': '¿Quién busca algo así?', 'tasacion-acm': 'Una tasación', 'informe-propietario': 'Informe al propietario', 'landing-emprendimiento': 'Landing de un proyecto', 'ficha-con-tu-marca': 'Ficha PDF con tu marca', 'cambios-en-lote': 'Aviso legal en 23 fichas', 'segmentar-contactos': 'Los de Palermo sin visita', 'leer-fotos-planos': 'Mandale un plano', 'planillas-al-dia': 'Planillas al día' };
const familias: { nombre: string; ids: string[] }[] = [
  { nombre: 'Leads', ids: ['resumen-del-dia', 'cargar-lead', 'quien-consulto', 'rutina-leads-sin-cargar'] },
  { nombre: 'Buscar', ids: ['buscar-cartera', 'buscar-red', 'quien-busca-algo-asi'] },
  { nombre: 'Tasar y armar', ids: ['tasacion-acm', 'informe-propietario', 'landing-emprendimiento', 'ficha-con-tu-marca'] },
  { nombre: 'Fichas y base', ids: ['cambios-en-lote', 'segmentar-contactos', 'leer-fotos-planos', 'planillas-al-dia'] },
];
---
<section class="simple" id="hero" aria-labelledby="h1">
  <div class="wrap simple-grid">
    <div class="simple-copy">
      <p class="eyebrow in-1">Centralito · Para inmobiliarias</p>
      <h1 id="h1" class="in-2">Operá tu Tokko desde <em>WhatsApp</em>, sin abrirlo.</h1>
      <p class="lead in-3">Centralito es un colega de IA: le escribís, entra a tu Tokko, hace el trabajo y te cuenta qué hizo. Lo que sale hacia un cliente lo mandás vos.</p>
      <div class="simple-cta in-4">
        <a class="btn btn-primary" href="/empezar" data-cta="empezar" data-section="hero">Empezar</a>
        <WaLink section="hero" />
        <PriceLine />
      </div>
      <div class="pedidos in-5" data-pedidos>
        <div class="pedidos-head"><p class="mono up">Pedile, por ejemplo</p><p class="mono vistos" data-vistos>Viste 0 de {TOTAL} pedidos</p></div>
        {familias.map(f => (
          <div class="familia">
            <span class="fam-label">{f.nombre}</span>
            <div class="fam-chips">
              {f.ids.map(id => <button type="button" class="pill" data-scene-trigger={id} data-target="hero" aria-pressed={id === 'resumen-del-dia' ? 'true' : 'false'} title={SCENES[id].titulo}>{corto[id] || SCENES[id].chip}</button>)}
            </div>
          </div>
        ))}
      </div>
      <div class="in-6"><Proof /></div>
    </div>
    <div class="simple-chat in-3">
      <div class="aura" aria-hidden="true"></div>
      <div class="avatar-tile" aria-hidden="true"><img src="/assets/centralito.jpg" width="150" height="150" alt=""></div>
      <Chat instance="hero" scene="resumen-del-dia" mode="hero" class="chat-xl" />
      <div class="chips-control"><span class="chip">OK antes de cambiar en lote</span><span class="chip">Te dice cuánto leyó</span><span class="chip">Te cuenta qué hizo</span></div>
      <p class="mono up ejemplo">Ejemplo · los nombres y las cifras son de demostración</p>
    </div>
  </div>
</section>
