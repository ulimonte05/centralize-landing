---
import Chat from '@/components/Chat.astro';
import WaLink from '@/components/WaLink.astro';
import PlanCard from '@/components/PlanCard.astro';
import Proof from '@/components/Proof.astro';
import { SCENES, CARTA_IDS, MINI_IDS } from '@/lib/scenes';
const fam: Record<string, string> = { 'resumen-del-dia': 'leads', 'buscar-red': 'buscar', 'tasacion-acm': 'tasar', 'segmentar-contactos': 'segmentar', 'cambios-en-lote': 'fichas', 'informe-propietario': 'informes', 'cargar-lead': 'leads', 'quien-consulto': 'leads', 'buscar-cartera': 'buscar', 'ficha-con-tu-marca': 'fichas', 'leer-fotos-planos': 'fichas', 'quien-busca-algo-asi': 'segmentar', 'planillas-al-dia': 'rutinas', 'rutina-leads-sin-cargar': 'rutinas', 'landing-emprendimiento': 'armar' };
const ids = [...CARTA_IDS, ...MINI_IDS.slice(0, 4)];
const bubble = (id: string) => { const s = SCENES[id]; const m = (s.variante_hero?.mensajes || s.mensajes).find(x => x.de === 'asesor'); return m?.texto || s.chip; };
---
<section class="catalogo" id="hero" aria-labelledby="h1">
  <div class="wrap">
    <div class="cat-head">
      <p class="eyebrow">Centralito · Para inmobiliarias</p>
      <h1 id="h1">Centralito, IA en tu <em>WhatsApp</em> para operar Tokko.</h1>
      <p class="lead">Centralito trabaja para vos: busca, ordena, tasa, arma y recuerda. Tocá un pedido y miralo trabajar. Todo lo que le llega a un cliente lo mandás vos.</p>
      <div class="cta-row" style="margin-top:18px"><a class="btn btn-primary" href="/empezar" data-cta="empezar" data-section="hero">Empezar</a><WaLink section="hero" /></div>
    </div>
    <div class="bento">
      <div class="tile-chat"><Chat instance="hero" scene="resumen-del-dia" mode="hero" /></div>
      {ids.map((id, i) => <button type="button" class="tile" data-scene-trigger={id} data-target="hero" aria-pressed={i === 0 ? 'true' : 'false'}><span class="fam">{fam[id]}</span><span class="bub">{bubble(id)}</span><span class="res">✓ visto</span></button>)}
      <div class="tile-precio"><PlanCard compact /></div>
    </div>
    <p class="mono up ejemplo" style="text-align:left;margin-top:14px">Ejemplo · los nombres y las cifras son de demostración</p>
    <div style="margin-top:12px"><Proof /></div>
  </div>
</section>
