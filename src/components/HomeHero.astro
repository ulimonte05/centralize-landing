---
import Chat from '@/components/Chat.astro';
import MobileBar from '@/components/MobileBar.astro';
import { CORTO } from '@/lib/pedidos';
import { OFFER } from '@/lib/offer';
// La demo arranca con la tasación (el gancho más fuerte); los chips cambian a la Red Tokko y al recordatorio del día.
const demo = ['tasacion-acm', 'buscar-red', 'resumen-del-dia'];
const chips = demo.map(id => `<button type="button" class="pill" data-scene-trigger="${id}" data-target="hero" aria-pressed="${id === demo[0]}">${CORTO[id]}</button>`).join('');
---
<section class="hero" id="hero" aria-labelledby="h1">
  <div class="wrap">
    <div class="hero-copy">
      <h1 id="h1">Pedile lo que quieras a tu CRM <em>por WhatsApp.</em></h1>
      <p class="lead"><span class="only-d">Centralito es el asistente que opera tu CRM inmobiliario: tasa con comparables de la Red Tokko, edita una ficha con un mensaje, arma el PDF de una propiedad y te recuerda los seguimientos.</span><span class="only-m">El asistente que opera tu CRM inmobiliario: tasa, edita fichas, arma PDFs y te recuerda los seguimientos.</span></p>
      <div class="hero-cta" data-bar-sentinel>
        <a class="btn btn-primary" href="/contratar" data-cta="contratar" data-section="hero">{OFFER.cta}</a>
        <p class="hero-sub">{OFFER.sub}</p>
      </div>
    </div>
    <div class="hero-chat">
      <Chat instance="hero" scene={demo[0]} mode="hero" controls={false} />
      <div class="hero-pedidos" role="group" aria-label="Otros pedidos de ejemplo"><span>Probá otro pedido:</span><Fragment set:html={chips} /></div>
      <p class="hero-nota">Ejemplo con nombres y cifras de demostración.</p>
    </div>
  </div>
</section>
<MobileBar section="home" primary={{ href: '/contratar', label: OFFER.cta, cta: 'contratar' }} />
