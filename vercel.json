{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/ventas", "destination": "/inmobiliarias", "permanent": true },
    { "source": "/a-medida", "destination": "/inmobiliarias", "permanent": true },
    { "source": "/centralito", "destination": "/", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacy-policy", "permanent": true }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/gracias", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
